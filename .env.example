# 複製這個檔案為 .env，再填入你自己的值。.env 不要上傳/分享給別人（裡面有金鑰）。

# 1) Google AI Studio 的 Gemini API 金鑰
#    取得方式：開啟 https://aistudio.google.com/apikey → 建立 API 金鑰 → 貼在下面
GEMINI_API_KEY=

# 可留預設值即可（便宜、適合這個用途的模型）
GEMINI_MODEL=gemini-3.5-flash-lite

# 2) Google 試算表（研究資料要存的地方）
#    - GOOGLE_SHEET_ID：開啟你要存資料的 Google 試算表，網址中 /d/ 和 /edit 之間那一串英數字
#    - GOOGLE_SERVICE_ACCOUNT_JSON：服務帳戶金鑰檔案的路徑（見 README「設定 Google 試算表」步驟）
#    這兩項若留空，資料仍會存在本機 data/interactions.json，只是不會同步到 Google 試算表。
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json
GOOGLE_SHEET_TAB=interactions

# 3) 研究者/教師頁面的簡易密碼（切換條件、看即時紀錄、匯出CSV都需要）
#    留空 = 不需密碼即可進入研究者頁面，僅建議自己在本機測試時這樣做。
TEACHER_TOKEN=changeme

# 4) 伺服器要用哪個連接埠（通常不用改）
PORT=3000
